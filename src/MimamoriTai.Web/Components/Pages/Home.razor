@page "/"
@rendermode InteractiveServer
@using MimamoriTai.Core.Application
@using MimamoriTai.Core.Domain
@using MimamoriTai.Web.Services
@using Microsoft.EntityFrameworkCore
@using MimamoriTai.Infrastructure.Data
@inject DashboardService Dashboard
@inject AssistantOrchestrator Orchestrator
@inject DeviceControlService Control
@inject AppDbContext Db
@inject IWebHostEnvironment Env
@inject WatchAlertService AlertService
@inject DeviceSyncService DeviceSync
@inject MimamoriTai.Core.Abstractions.IEventStreamPublisher StreamPublisher

<PageTitle>CareRoute AI / 見守り隊</PageTitle>

<header class="hero">
    <div>
        <h1>CareRoute AI <span class="jp">見守り隊</span></h1>
        <p class="tagline">離れていても、家族の“いつも”をAIがつなぐ。</p>
    </div>
    <div class="integrations">
        @if (_model is not null)
        {
            <span class="chip @(_model.Integrations.SwitchBotConfigured ? "on" : "mock")">
                データ: @(_model.Integrations.SwitchBotConfigured ? "実機（SwitchBot）" : "デモ")
            </span>
            <span class="chip @(_model.Integrations.DeviceProvider == "SwitchBot" ? "on" : "mock")">
                Devices: @_model.Integrations.DeviceProvider
            </span>
            <span class="chip @(_model.Integrations.OrcaRouterConfigured ? "on" : "mock")">
                OrcaRouter: @(_model.Integrations.OrcaRouterConfigured ? "Live" : "Mock")
            </span>
            <span class="chip @(_model.Integrations.FabricConfigured ? "on" : "mock")">
                Fabric: @(_model.Integrations.FabricConfigured ? "Live" : "Local")
            </span>
            <span class="chip @(_model.Integrations.LineConfigured ? "on" : "mock")">
                LINE: @(_model.Integrations.LineConfigured ? "Live" : "Mock")
            </span>
            <span class="chip @(_model.Integrations.EventhouseConfigured ? "on" : "mock")">
                Stream: @(_model.Integrations.EventhouseConfigured ? "実ストリーム" : "デモ")
            </span>
            <span class="chip neutral">DB: @_model.Integrations.Database</span>
        }
    </div>
</header>

@if (_model is null)
{
    <p class="loading">読み込み中…</p>
}
else
{
    @if (_notice is not null)
    {
        <div class="notice notice-@_noticeKind" role="status" aria-live="polite">
            <span class="notice-icon">@(_noticeKind == "ok" ? "✓" : _noticeKind == "blocked" ? "⛔" : "⚠")</span>
            <span>@_notice</span>
            <button class="notice-close" @onclick="() => _notice = null" aria-label="閉じる">✕</button>
        </div>
    }

    @if (_busy)
    {
        <div class="busy-bar" role="status" aria-live="polite">処理中…</div>
    }

    <section class="grid">
        <article class="card risk risk-@_model.Risk.Level.ToString().ToLowerInvariant()">
            <h2>現在の見守りステータス</h2>
            <p class="risk-level">@RiskLabel(_model.Risk.Level)</p>
            <p class="risk-reason">@_model.Risk.Reason</p>
            <p class="muted">スコア @_model.Risk.Score / 100 ・ ルールベース判定</p>
            <button class="ghost small" title="現在のリスクを評価し、必要であればLINEにアラートを送信します"
                    @onclick="EvaluateAlertAsync" disabled="@_busy">
                見守りアラートを確認
            </button>
        </article>

        <article class="card">
            <h2>家族メンバー</h2>
            <ul class="people">
                @foreach (var person in _model.People)
                {
                    <li><span class="role">@RoleLabel(person.Role)</span> @person.DisplayName</li>
                }
            </ul>
            <h3>今日のサマリー</h3>
            <p class="muted">
                最初の活動: @(_model.Today.FirstActivityTime?.ToString("HH\\:mm") ?? "—") ／
                最後の活動: @(_model.Today.LastActivityTime?.ToString("HH\\:mm") ?? "—") ／
                利用回数: @_model.Today.DeviceUsageCount 回
            </p>
        </article>

        <article class="card ai">
            <h2>AIルーティング</h2>
            <p class="model-name">@(_model.LastResolvedModel ?? "未使用")</p>
            <p class="muted">OrcaRouter が解決した直近のモデル名</p>
        </article>
    </section>

    <section class="devices">
        <div class="section-head">
            <h2>デバイス</h2>
            <span class="muted">ボタン操作も自然言語と同じ安全ガードレールを通ります</span>
        </div>
        <div class="device-grid">
            @foreach (var device in _model.Devices)
            {
                var d = device;
                <div class="device-card @(d.IsOn ? "on" : "off") @(d.SafetyClass == "Restricted" ? "restricted" : "")">
                    <div class="device-head">
                        <strong>@d.Name</strong>
                        <span class="state">@(d.IsOn ? "ON" : "OFF")</span>
                    </div>
                    <p class="muted">@d.Room ・ @d.DeviceType ・ @d.Alias</p>
                    <p class="muted">最終利用: @FormatLocal(d.LastUsedUtc)</p>
                    <p class="muted">今日の利用: @d.TodayUsageCount 回</p>
                    <p class="muted">
                        遠隔操作: @(d.RemoteControlAllowed ? "許可" : "禁止") ・
                        <span class="safety safety-@d.SafetyClass.ToLowerInvariant()">@d.SafetyClass</span>
                    </p>

                    <div class="device-actions">
                        <button class="btn-on"
                                title="@(d.SafetyClass == "Restricted" ? "危険機器のためONは拒否されます" : "ONにする")"
                                @onclick="@(() => ControlAsync(d.Alias, DeviceAction.TurnOn))"
                                disabled="@_busy">
                            ON
                        </button>
                        <button class="btn-off"
                                title="OFFにする"
                                @onclick="@(() => ControlAsync(d.Alias, DeviceAction.TurnOff))"
                                disabled="@_busy">
                            OFF
                        </button>
                        <button class="ghost small"
                                title="現在の状態を確認"
                                @onclick="@(() => ControlAsync(d.Alias, DeviceAction.GetStatus))"
                                disabled="@_busy">
                            状態
                        </button>
                    </div>

                    @if (d.SafetyClass == "Restricted")
                    {
                        <p class="restricted-note">危険機器：ONは拒否され、OFFのみ許可されます</p>
                    }
                </div>
            }
        </div>
    </section>

    <section class="two-col">
        <article class="card">
            <div class="section-head">
                <h2>自然言語で操作・質問</h2>
                @if (_chatLog.Count > 0)
                {
                    <button class="ghost small" @onclick="() => _chatLog.Clear()" disabled="@_busy">クリア</button>
                }
            </div>
            <div class="chat-log">
                @if (_chatLog.Count == 0)
                {
                    <p class="muted empty">下のボタンを押すか、自由に入力して話しかけてください。</p>
                }
                @foreach (var line in _chatLog)
                {
                    <div class="chat-line @(line.IsAi ? "ai" : "user")">
                        <span class="author">@line.Author</span>
                        <span class="text">@line.Content</span>
                    </div>
                }
            </div>
            <div class="chat-input">
                <input @bind="_input" @bind:event="oninput" @onkeydown="OnKeyDown"
                       placeholder="例: リビングのライトつけて / 今日のお母さんどう？" disabled="@_busy" />
                <button @onclick="SendAsync" disabled="@(_busy || string.IsNullOrWhiteSpace(_input))">送信</button>
            </div>

            @foreach (var group in SampleGroups)
            {
                <div class="quick-group">
                    <span class="quick-label">@group.Label</span>
                    <div class="quick">
                        @foreach (var sample in group.Samples)
                        {
                            var text = sample;
                            <button class="ghost @(group.Kind)" @onclick="@(() => SendSampleAsync(text))" disabled="@_busy">@text</button>
                        }
                    </div>
                </div>
            }
        </article>

        <article class="card">
            <h2>LINE シミュレーター</h2>
            <p class="muted">LINEの認証情報が無くても、グループLINEでの会話を再現できます。</p>
            <div class="line-controls">
                <select @bind="_lineSpeaker" disabled="@_busy">
                    @foreach (var person in _model.People)
                    {
                        <option value="@person.Id">@person.DisplayName</option>
                    }
                </select>
                <input @bind="_lineInput" @bind:event="oninput" @onkeydown="OnLineKeyDown"
                       placeholder="例: 今日のお母さんどう？" disabled="@_busy" />
                <button @onclick="SendLineAsync" disabled="@(_busy || string.IsNullOrWhiteSpace(_lineInput))">LINEで送る</button>
            </div>
            <div class="quick">
                @foreach (var sample in LineSamples)
                {
                    var text = sample;
                    <button class="ghost" @onclick="@(() => SendLineSampleAsync(text))" disabled="@_busy">@text</button>
                }
            </div>

            <h3>家族共有フィード</h3>
            <div class="feed">
                @foreach (var item in _model.Feed)
                {
                    <div class="feed-item @(item.IsAi ? "ai" : "")">
                        <span class="author">@item.Author</span>
                        <span class="time">@FormatLocal(item.OccurredAtUtc)</span>
                        <p>@item.Content</p>
                    </div>
                }
            </div>
        </article>
    </section>

    <section class="two-col">
        <article class="card">
            <h2>生活イベント タイムライン</h2>
            <ul class="timeline">
                @foreach (var item in _model.Timeline)
                {
                    <li>
                        <span class="time">@FormatLocal(item.OccurredAtUtc)</span>
                        <span>@item.DeviceName</span>
                        <span class="state @item.State">@item.State.ToUpperInvariant()</span>
                    </li>
                }
            </ul>
        </article>

        <article class="card">
            <h2>直近14日の活動</h2>
            <ul class="history">
                @foreach (var day in _model.Recent.Reverse())
                {
                    <li>
                        <span class="date">@day.Date.ToString("M/d")</span>
                        <span class="bar" style="width:@(Math.Min(day.DeviceUsageCount * 12, 120))px"></span>
                        <span class="muted">@day.DeviceUsageCount 回 @(day.NightActivityCount > 0 ? $"／深夜{day.NightActivityCount}回" : "")</span>
                    </li>
                }
            </ul>

            @if (Env.IsDevelopment())
            {
                <h3>デモ用シミュレーション</h3>
                <p class="muted">今日の生活イベントを差し替えて、リスク判定の変化を確認できます。</p>
                <div class="quick">
                    <button class="ghost act" @onclick="@(() => SimulateAsync("normal_day"))" disabled="@_busy">通常の一日</button>
                    <button class="ghost danger" @onclick="@(() => SimulateAsync("no_activity"))" disabled="@_busy">活動なし異常</button>
                    <button class="ghost danger" @onclick="@(() => SimulateAsync("night_activity"))" disabled="@_busy">深夜活動異常</button>
                </div>
            }

            <h3>実機データの同期</h3>
            @if (_model.Integrations.SwitchBotConfigured)
            {
                <p class="muted">SwitchBot実機の最新の機器一覧をデータベースに反映します。</p>
                <div class="quick">
                    <button class="ghost act" @onclick="SyncDevicesAsync" disabled="@_busy">実機を同期</button>
                </div>
            }
            else
            {
                <p class="muted">現在はデモデータで動作しています。SwitchBotの接続情報（Token/Secret）を設定すると、実機を同期できます。</p>
                <div class="quick">
                    <button class="ghost act" disabled>実機を同期（未設定）</button>
                </div>
            }

            <h3>Fabricへのストリーミング</h3>
            <p class="muted">
                直近のデバイスイベントをFabric Eventhouse（KQL）へ送信し、リアルタイム分析パスを確認します。
                @(_model.Integrations.EventhouseConfigured ? "現在は実ストリームに接続されています。" : "現在は未設定のためデモ動作（送信をシミュレート）します。")
            </p>
            <div class="quick">
                <button class="ghost act" @onclick="PublishToStreamAsync" disabled="@_busy">Fabricへ送信</button>
            </div>
        </article>
    </section>
}

@code {
    private sealed record SampleGroup(string Label, string Kind, string[] Samples);

    private static readonly SampleGroup[] SampleGroups =
    [
        new("家電を操作", "act",
        [
            "リビングのライトつけて",
            "リビングのライト消して",
            "扇風機つけて"
        ]),
        new("安全ガードレール（拒否デモ）", "danger",
        [
            "ストーブつけて",
            "ストーブ消して"
        ]),
        new("生活データに質問", "ask",
        [
            "今日のお母さんどう？",
            "今日最初に活動したのは何時？",
            "リビングのライトは今ついてる？"
        ])
    ];

    private static readonly string[] LineSamples =
    [
        "今日のお母さんどう？",
        "リビングのライトつけて",
        "ストーブつけて"
    ];

    private DashboardModel? _model;
    private readonly List<FeedItem> _chatLog = [];
    private string _input = string.Empty;
    private string _lineInput = string.Empty;
    private Guid? _lineSpeaker;
    private bool _busy;
    private string? _notice;
    private string _noticeKind = "ok";

    protected override async Task OnInitializedAsync() => await ReloadAsync();

    private async Task ReloadAsync()
    {
        var householdId = await Dashboard.GetDefaultHouseholdIdAsync();
        if (householdId is null)
        {
            return;
        }

        _model = await Dashboard.LoadAsync(householdId.Value);
        _lineSpeaker ??= _model?.People.FirstOrDefault(p => p.Role == PersonRole.Family)?.Id;
    }

    private async Task OnKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Enter")
        {
            await SendAsync();
        }
    }

    private async Task OnLineKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Enter")
        {
            await SendLineAsync();
        }
    }

    private async Task SendSampleAsync(string text)
    {
        _input = text;
        await SendAsync();
    }

    private async Task SendLineSampleAsync(string text)
    {
        _lineInput = text;
        await SendLineAsync();
    }

    /// <summary>
    /// Button presses go through the same DeviceControlService as chat commands, so the
    /// safety policy and the DeviceCommand audit trail apply identically. The UI never
    /// gets a privileged path around the guard rails.
    /// </summary>
    private async Task ControlAsync(string alias, DeviceAction action)
    {
        if (_model is null || _busy)
        {
            return;
        }

        _busy = true;
        StateHasChanged();

        try
        {
            var outcome = await Control.ExecuteAsync(
                _model.HouseholdId,
                alias,
                action,
                confidence: 1.0,
                originalText: $"[ボタン操作] {alias} / {action}",
                source: CommandSource.Web,
                requestedByPersonId: null,
                aiResolvedModel: null);

            _notice = outcome.Message;
            _noticeKind = outcome.Status switch
            {
                CommandStatus.Succeeded => "ok",
                CommandStatus.Rejected => "blocked",
                _ => "warn"
            };

            await ReloadAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private Task SendAsync() => SendCoreAsync(_input, CommandSource.Web, null, () => _input = string.Empty);

    private Task SendLineAsync() => SendCoreAsync(_lineInput, CommandSource.Line, _lineSpeaker, () => _lineInput = string.Empty);

    private async Task SendCoreAsync(string message, CommandSource source, Guid? personId, Action clearInput)
    {
        if (_model is null || string.IsNullOrWhiteSpace(message) || _busy)
        {
            return;
        }

        _busy = true;
        var text = message.Trim();
        clearInput();

        var author = personId is { } id
            ? _model.People.FirstOrDefault(p => p.Id == id)?.DisplayName ?? "家族"
            : "あなた";

        _chatLog.Add(new FeedItem(DateTimeOffset.UtcNow, author, text, false));
        StateHasChanged();

        try
        {
            var response = await Orchestrator.HandleAsync(
                new AssistantRequest(_model.HouseholdId, personId, text, source));

            _chatLog.Add(new FeedItem(DateTimeOffset.UtcNow, "見守りAI", response.Reply, true));
            await ReloadAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    /// <summary>
    /// Runs the same WatchAlertService the background poller and the /api/alerts/evaluate
    /// endpoint use, so the demo button shows a real dedup/cooldown decision, not a canned one.
    /// </summary>
    private async Task EvaluateAlertAsync()
    {
        if (_model is null || _busy)
        {
            return;
        }

        _busy = true;
        StateHasChanged();

        try
        {
            var outcome = await AlertService.EvaluateAsync(_model.HouseholdId);

            _notice = outcome.Status switch
            {
                WatchAlertStatus.Sent => $"アラートを送信しました：{outcome.Message}",
                WatchAlertStatus.SendFailed =>
                    $"アラートの送信に失敗しました（{outcome.SendResult?.Error ?? "不明なエラー"}）。内容: {outcome.Message}",
                _ => outcome.Message
            };

            _noticeKind = outcome.Status switch
            {
                WatchAlertStatus.Sent => "ok",
                WatchAlertStatus.SendFailed => "blocked",
                WatchAlertStatus.SuppressedByCooldown => "warn",
                _ => "ok"
            };

            await ReloadAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    /// <summary>
    /// Syncs real provider devices (SwitchBot) into the Devices table via
    /// DeviceSyncService, mirroring the /api/devices/sync endpoint. Only meaningful
    /// when SwitchBot is configured; the button is disabled otherwise.
    /// </summary>
    private async Task SyncDevicesAsync()
    {
        if (_model is null || _busy || !_model.Integrations.SwitchBotConfigured)
        {
            return;
        }

        _busy = true;
        StateHasChanged();

        try
        {
            var result = await DeviceSync.SyncAsync(_model.HouseholdId);

            _notice = $"実機の同期が完了しました（追加 {result.Added}／更新 {result.Updated}／無効化 {result.Deactivated}）。";
            _noticeKind = "ok";

            await ReloadAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    /// <summary>
    /// Publishes the most recent DeviceEvent rows to the Fabric Eventhouse real-time
    /// stream via IEventStreamPublisher, mirroring /api/stream/publish. Azure SQL
    /// remains the source of truth; this is purely for proving the streaming path.
    /// </summary>
    private async Task PublishToStreamAsync()
    {
        if (_model is null || _busy)
        {
            return;
        }

        _busy = true;
        StateHasChanged();

        try
        {
            var recent = await Db.DeviceEvents
                .OrderByDescending(e => e.OccurredAtUtc)
                .Take(50)
                .ToListAsync();

            var deviceIds = recent.Select(e => e.DeviceId).Distinct().ToList();
            var devices = await Db.Devices.Where(d => deviceIds.Contains(d.Id)).ToDictionaryAsync(d => d.Id);

            var records = recent.Select(e =>
            {
                devices.TryGetValue(e.DeviceId, out var device);
                return new MimamoriTai.Core.Abstractions.DeviceEventRecord(
                    e.Id,
                    e.HouseholdId,
                    e.DeviceId,
                    device?.Name ?? string.Empty,
                    device?.Room ?? string.Empty,
                    device?.DeviceType.ToString() ?? string.Empty,
                    e.EventType,
                    e.State,
                    e.PowerWatts,
                    e.Source.ToString(),
                    e.OccurredAtUtc.UtcDateTime);
            }).ToList();

            var result = await StreamPublisher.PublishAsync(records);

            if (result.Success)
            {
                _notice = $"Fabricへの送信が完了しました（{result.PublishedCount} 件・{result.DurationMs}ms・{StreamPublisher.DisplayName}）。";
                _noticeKind = "ok";
            }
            else
            {
                _notice = $"Fabricへの送信に失敗しました（{result.Error}）。";
                _noticeKind = "warn";
            }
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task SimulateAsync(string scenario)
    {
        if (_model is null || _busy)
        {
            return;
        }

        _busy = true;
        try
        {
            var householdId = _model.HouseholdId;
            var dayStart = HouseholdTime.StartOfLocalDayUtc(HouseholdTime.LocalDate(DateTimeOffset.UtcNow));
            var devices = await Db.Devices.Where(d => d.HouseholdId == householdId).ToListAsync();

            if (scenario is "no_activity" or "normal_day")
            {
                var existing = await Db.DeviceEvents
                    .Where(e => e.HouseholdId == householdId && e.OccurredAtUtc >= dayStart)
                    .ToListAsync();
                Db.DeviceEvents.RemoveRange(existing);
            }

            if (scenario == "normal_day")
            {
                AddEvents(householdId, devices, dayStart,
                    ("bedroom-light", "on", 7 * 60),
                    ("bedroom-light", "off", 7 * 60 + 12),
                    ("living-light", "on", 7 * 60 + 20),
                    ("living-light", "off", 12 * 60),
                    ("living-light", "on", 18 * 60));
            }
            else if (scenario == "night_activity")
            {
                AddEvents(householdId, devices, dayStart,
                    ("living-light", "on", 2 * 60 + 10),
                    ("living-light", "off", 2 * 60 + 45),
                    ("bedroom-light", "on", 3 * 60 + 5),
                    ("bedroom-light", "off", 3 * 60 + 25));
            }

            await Db.SaveChangesAsync();
            _notice = scenario switch
            {
                "normal_day" => "通常の一日のデータに差し替えました。",
                "no_activity" => "今日の活動データを削除しました（活動なし異常）。",
                _ => "深夜帯の活動データを追加しました。"
            };
            _noticeKind = scenario == "normal_day" ? "ok" : "warn";
            await ReloadAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private void AddEvents(Guid householdId, List<Device> devices, DateTimeOffset dayStart,
        params (string Alias, string State, int Minutes)[] items)
    {
        foreach (var (alias, state, minutes) in items)
        {
            var device = devices.FirstOrDefault(d => d.Alias == alias) ?? devices.FirstOrDefault();
            if (device is null)
            {
                continue;
            }

            Db.DeviceEvents.Add(new DeviceEvent
            {
                HouseholdId = householdId,
                DeviceId = device.Id,
                EventType = "PowerState",
                State = state,
                PowerWatts = state == "on" ? 32.0 : 0.0,
                Source = EventSource.Simulator,
                OccurredAtUtc = dayStart.AddMinutes(minutes),
                ReceivedAtUtc = dayStart.AddMinutes(minutes)
            });
        }
    }

    private static string RiskLabel(RiskLevel level) => level switch
    {
        RiskLevel.High => "要確認",
        RiskLevel.Medium => "少し気になる",
        _ => "いつもどおり"
    };

    private static string RoleLabel(PersonRole role) => role switch
    {
        PersonRole.Resident => "本人",
        PersonRole.Family => "家族",
        _ => "管理者"
    };

    private static string FormatLocal(DateTimeOffset? utc) =>
        utc is null ? "—" : HouseholdTime.ToLocal(utc.Value).ToString("M/d HH:mm");
}
