    // ---- Trend charts -------------------------------------------------------
    // All three read the daily figures the dashboard already loads, so drawing them
    // costs no extra query. Today is highlighted so the family can see at a glance
    // whether today stands out from the fortnight behind it.

    private IReadOnlyList<BarChartPoint> UsageTrend() =>
        TrendPoints(d => d.DeviceUsageCount);

    private IReadOnlyList<BarChartPoint> NightTrend() =>
        TrendPoints(d => d.NightActivityCount);

    /// <summary>
    /// One recorded day is enough to draw. A single bar is honest about how little there is
    /// so far; hiding it behind "データがありません" would be less so. What waits for a second
    /// day is the wording of a trend - see the verdict badges.
    /// </summary>
    private bool HasTrendData() =>
        _model is not null && _model.Recent.Any(d => d.FirstActivityTime is not null);

    private TrendVerdict UsageVerdict() =>
        TrendVerdicts.ForUsage(
            TodayValue(d => d.DeviceUsageCount), Baseline(d => d.DeviceUsageCount), HoursIntoToday())
        ?? EmptyVerdict;

    private TrendVerdict NightVerdict() =>
        TrendVerdicts.ForNight(
            TodayValue(d => d.NightActivityCount), Baseline(d => d.NightActivityCount), HoursIntoToday())
        ?? EmptyVerdict;

    private TrendVerdict WakeUpVerdict() =>
        TrendVerdicts.ForWakeUp(TodayWakeUpHours(), WakeUpBaseline()) ?? EmptyVerdict;

    /// <summary>How much of today has happened, so a quiet morning is not called a quiet day.</summary>
    private static double HoursIntoToday() =>
        HouseholdTime.LocalTime(DateTimeOffset.UtcNow).ToTimeSpan().TotalHours;

    /// <summary>No badge at all, rather than a hedge like "判定できません" on every card.</summary>
    private static readonly TrendVerdict EmptyVerdict = new(string.Empty, string.Empty);

    private double? TodayValue(Func<DailyActivity, double> value)
    {
        var today = HouseholdTime.LocalDate(DateTimeOffset.UtcNow);
        var match = _model?.Recent.LastOrDefault(d => d.Date == today);

        return match is null ? null : value(match);
    }

    /// <summary>
    /// The days before today, and only those with something recorded: a device that was
    /// offline for a week would otherwise drag the "usual" down to nothing.
    /// </summary>
    private IReadOnlyList<double> Baseline(Func<DailyActivity, double> value)
    {
        if (_model is null)
        {
            return [];
        }

        var today = HouseholdTime.LocalDate(DateTimeOffset.UtcNow);

        return [.. _model.Recent
            .Where(d => d.Date < today && d.FirstActivityTime is not null)
            .Select(value)];
    }

    private double? TodayWakeUpHours()
    {
        var today = HouseholdTime.LocalDate(DateTimeOffset.UtcNow);
        var match = _model?.Recent.LastOrDefault(d => d.Date == today);

        return match?.FirstActivityTime is { } t ? t.ToTimeSpan().TotalHours : null;
    }

    private IReadOnlyList<double> WakeUpBaseline()
    {
        if (_model is null)
        {
            return [];
        }

        var today = HouseholdTime.LocalDate(DateTimeOffset.UtcNow);

        return [.. _model.Recent
            .Where(d => d.Date < today && d.FirstActivityTime is not null)
            .Select(d => d.FirstActivityTime!.Value.ToTimeSpan().TotalHours)];
    }

    /// <summary>
    /// Getting-up time as hours past midnight, so a later start makes a taller bar.
    /// Days with no activity at all stay at zero rather than being dropped: a missing
    /// morning is the single most important thing on this screen. The tooltip shows a
    /// real clock time, because "6.5時" is not how anyone reads a wake-up time.
    /// </summary>
    private IReadOnlyList<BarChartPoint> WakeUpTrend()
    {
        var days = TrendDays();
        if (days.Count == 0)
        {
            return [];
        }

        var today = HouseholdTime.LocalDate(DateTimeOffset.UtcNow);

        return [.. days.Select(d => new BarChartPoint(
            d.Date.ToString("M/d"),
            d.FirstActivityTime is { } t ? Math.Round(t.ToTimeSpan().TotalHours, 2) : 0,
            d.Date == today,
            d.FirstActivityTime?.ToString("H\\:mm") ?? "記録なし"))];
    }

    private IReadOnlyList<BarChartPoint> TrendPoints(Func<DailyActivity, double> value)
    {
        var days = TrendDays();
        if (days.Count == 0)
        {
            return [];
        }

        var today = HouseholdTime.LocalDate(DateTimeOffset.UtcNow);

        return [.. days.Select(d =>
            new BarChartPoint(d.Date.ToString("M/d"), value(d), d.Date == today))];
    }

    /// <summary>
    /// The days worth charting: everything from the first day something was recorded.
    /// A household that signed up yesterday gets one bar rather than one bar preceded by
    /// thirteen empty ones - padding the start with days that pre-date the household
    /// would suggest a fortnight of silence that never actually happened.
    /// </summary>
    private IReadOnlyList<DailyActivity> TrendDays()
    {
        if (_model is null)
        {
            return [];
        }

        var first = _model.Recent
            .Select((d, i) => (Day: d, Index: i))
            .FirstOrDefault(x => x.Day.FirstActivityTime is not null);

        return first.Day is null ? [] : [.. _model.Recent.Skip(first.Index)];
    }

    /// <summary>Spells the series out for screen readers, which cannot read the bars.</summary>
    private string TrendAriaLabel(string title, Func<DailyActivity, int> value, string unit)
    {
        if (_model is null || _model.Recent.Count == 0)
        {
            return $"{title}：まだ記録がありません";
        }

        var parts = _model.Recent.Select(d => $"{d.Date:M月d日} {value(d)}{unit}");
        return $"{title}：{string.Join("、", parts)}";
    }

    private string WakeUpAriaLabel()
    {
        if (_model is null || _model.Recent.Count == 0)
        {
            return "起きた時間：まだ記録がありません";
        }

        var parts = _model.Recent.Select(d =>
            $"{d.Date:M月d日} {d.FirstActivityTime?.ToString("H\\:mm") ?? "記録なし"}");
        return $"起きた時間：{string.Join("、", parts)}";
    }

