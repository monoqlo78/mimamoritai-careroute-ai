    /// <summary>
    /// Publishes the most recent DeviceEvent rows to the Fabric Eventhouse real-time
    /// stream via IEventStreamPublisher, mirroring /api/stream/publish. Azure SQL
    /// remains the source of truth; this is purely for proving the streaming path.
    /// </summary>
    private async Task PublishToStreamAsync()
    {
        if (_model is null || _busy)
        {
            return;
        }

        _busy = true;
        StateHasChanged();

        try
        {
            var recent = await Db.DeviceEvents
                .OrderByDescending(e => e.OccurredAtUtc)
                .Take(50)
                .ToListAsync();

            var deviceIds = recent.Select(e => e.DeviceId).Distinct().ToList();
            var devices = await Db.Devices.Where(d => deviceIds.Contains(d.Id)).ToDictionaryAsync(d => d.Id);

            var records = recent.Select(e =>
            {
                devices.TryGetValue(e.DeviceId, out var device);
                return new MimamoriTai.Core.Abstractions.DeviceEventRecord(
                    e.Id,
                    e.HouseholdId,
                    e.DeviceId,
                    device?.DisplayName ?? string.Empty,
                    device?.DisplayRoom ?? string.Empty,
                    device?.DeviceType.ToString() ?? string.Empty,
                    e.EventType,
                    e.State,
                    e.PowerWatts,
                    e.Source.ToString(),
                    e.OccurredAtUtc.UtcDateTime);
            }).ToList();

            var result = await StreamPublisher.PublishAsync(records);

            if (result.Success)
            {
                _notice = $"Fabricへの送信が完了しました（{result.PublishedCount} 件・{result.DurationMs}ms・{StreamPublisher.DisplayName}）。";
                _noticeKind = "ok";
            }
            else
            {
                _notice = $"Fabricへの送信に失敗しました（{result.Error}）。";
                _noticeKind = "warn";
            }
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task SimulateAsync(string scenario)
    {
        if (_model is null || _busy)
        {
            return;
        }

        _busy = true;
        try
        {
            var householdId = _model.HouseholdId;
            var dayStart = HouseholdTime.StartOfLocalDayUtc(HouseholdTime.LocalDate(DateTimeOffset.UtcNow));
            var devices = await Db.Devices.Where(d => d.HouseholdId == householdId).ToListAsync();

            if (scenario is "no_activity" or "normal_day")
            {
                var existing = await Db.DeviceEvents
                    .Where(e => e.HouseholdId == householdId && e.OccurredAtUtc >= dayStart)
                    .ToListAsync();
                Db.DeviceEvents.RemoveRange(existing);
            }

            if (scenario == "normal_day")
            {
                AddEvents(householdId, devices, dayStart,
                    ("bedroom-light", "on", 7 * 60),
                    ("bedroom-light", "off", 7 * 60 + 12),
                    ("living-light", "on", 7 * 60 + 20),
                    ("living-light", "off", 12 * 60),
                    ("living-light", "on", 18 * 60));
            }
            else if (scenario == "night_activity")
            {
                AddEvents(householdId, devices, dayStart,
                    ("living-light", "on", 2 * 60 + 10),
                    ("living-light", "off", 2 * 60 + 45),
                    ("bedroom-light", "on", 3 * 60 + 5),
                    ("bedroom-light", "off", 3 * 60 + 25));
            }

            await Db.SaveChangesAsync();
            _notice = scenario switch
            {
                "normal_day" => "通常の一日のデータに差し替えました。",
                "no_activity" => "今日の活動データを削除しました（活動なし異常）。",
                _ => "深夜帯の活動データを追加しました。"
            };
            _noticeKind = scenario == "normal_day" ? "ok" : "warn";
            await ReloadAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private void AddEvents(Guid householdId, List<Device> devices, DateTimeOffset dayStart,
        params (string Alias, string State, int Minutes)[] items)
    {
        foreach (var (alias, state, minutes) in items)
        {
            var device = devices.FirstOrDefault(d => d.Alias == alias) ?? devices.FirstOrDefault();
            if (device is null)
            {
                continue;
            }

            Db.DeviceEvents.Add(new DeviceEvent
            {
                HouseholdId = householdId,
                DeviceId = device.Id,
                EventType = "PowerState",
                State = state,
                PowerWatts = state == "on" ? 32.0 : 0.0,
                Source = EventSource.Simulator,
                OccurredAtUtc = dayStart.AddMinutes(minutes),
                ReceivedAtUtc = dayStart.AddMinutes(minutes)
            });
        }
    }

