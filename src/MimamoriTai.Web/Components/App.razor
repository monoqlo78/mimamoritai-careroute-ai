<!DOCTYPE html>
<html lang="ja">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <script>
        (() => {
          // The dashboard is read by families of elderly residents, often on a phone that
          // silently switches to dark at night. Following prefers-color-scheme made the
          // same screen flip between a white and a near-black background, so the theme is
          // pinned to light; ?scoutTheme=dark stays available for capture tooling.
          const param = new URLSearchParams(window.location.search).get("scoutTheme");
          document.documentElement.setAttribute("data-theme", param || "light");
        })();
    </script>
    <ResourcePreloader />
    <link rel="icon" href="favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="images/mimamo-avatar.png" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["MimamoriTai.Web.styles.css"]" />
    <script src="@Assets["mimamori-ui.js"]"></script>
    <ImportMap />
    <HeadOutlet />
</head>

<body>
    <Routes />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>
